{
  "id": "TPL_HOTSPOT_CURRENT",
  "version": "1.0.0",
  "intent": "HOTSPOT_CURRENT",
  "tier": "A",
  "deprecated": false,
  "author": "P2",
  "reviewer": "P1",
  "reviewed": "2026-07-25",
  "purpose": "Current hotspots: rank unit by case count for a crime sub-head in a year, highlighting concentration.",
  "tables_declared": [
    "si_case_fact"
  ],
  "params": {
    "crime_subhead_id": {
      "type": "int",
      "required": true,
      "min": 1,
      "max": 9999,
      "description": "Specific offence."
    },
    "year_num": {
      "type": "year",
      "required": true,
      "min": 2019,
      "max": 2026,
      "description": "Single year."
    }
  },
  "scope": {
    "column": "unit_id",
    "conditions_consumed": 1,
    "exempt": false
  },
  "where_budget": {
    "template_conditions": 2,
    "ceiling": 5
  },
  "body": "SELECT unit_id, COUNT(case_id) FROM si_case_fact WHERE crime_subhead_id = {{crime_subhead_id}} AND year_num = {{year_num}} AND {{SCOPE_PREDICATE}} GROUP BY unit_id ORDER BY COUNT(case_id) DESC",
  "execute_on": "OLAP",
  "result": {
    "columns": [
      {
        "name": "unit_id",
        "source_key": "unit_id",
        "type": "int"
      },
      {
        "name": "count",
        "source_key": "COUNT(case_id)",
        "type": "int"
      }
    ],
    "max_rows": 50,
    "paginate": false,
    "visual_type": "MAP_POINTS",
    "min_cell_size_applies": true
  },
  "fixtures": [
    {
      "name": "hotspots chain snatching",
      "params": {
        "crime_subhead_id": 12,
        "year_num": 2024
      },
      "scope_values": [
        4430006,
        4430007,
        4430011
      ],
      "expect": {
        "min_rows": 1,
        "max_rows": 50,
        "must_not_error": true
      }
    },
    {
      "name": "other type",
      "params": {
        "crime_subhead_id": 78,
        "year_num": 2024
      },
      "scope_values": [
        4430006,
        4430007
      ],
      "expect": {
        "min_rows": 1,
        "max_rows": 50,
        "must_not_error": true
      }
    },
    {
      "name": "edge empty",
      "params": {
        "crime_subhead_id": 12,
        "year_num": 2019
      },
      "scope_values": [
        4430006
      ],
      "expect": {
        "min_rows": 0,
        "max_rows": 0,
        "must_not_error": true
      }
    }
  ],
  "limitations": [
    "Hotspot = raw concentration of registered cases, not a statistical cluster. True clustering (M12) is a QuickML step, not this template."
  ]
}