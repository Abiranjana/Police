{
  "id": "TPL_TREND_COMPARE_PERIOD",
  "version": "1.0.0",
  "intent": "TREND_COMPARE_PERIOD",
  "tier": "A",
  "deprecated": false,
  "author": "P2",
  "reviewer": "P1",
  "reviewed": "2026-07-25",
  "purpose": "Compare case counts for a sub-head across two years, within jurisdiction (this year vs last).",
  "tables_declared": [
    "si_case_fact"
  ],
  "params": {
    "crime_subhead_id": {
      "type": "int",
      "required": true,
      "min": 1,
      "max": 9999,
      "description": "Specific offence sub-head."
    }
  },
  "scope": {
    "column": "unit_id",
    "conditions_consumed": 1,
    "exempt": false
  },
  "where_budget": {
    "template_conditions": 1,
    "ceiling": 5
  },
  "body": "SELECT year_num, COUNT(case_id) FROM si_case_fact WHERE crime_subhead_id = {{crime_subhead_id}} AND {{SCOPE_PREDICATE}} GROUP BY year_num ORDER BY year_num",
  "execute_on": "OLAP",
  "result": {
    "columns": [
      {
        "name": "year_num",
        "source_key": "year_num",
        "type": "int"
      },
      {
        "name": "count",
        "source_key": "COUNT(case_id)",
        "type": "int"
      }
    ],
    "max_rows": 10,
    "paginate": false,
    "visual_type": "BAR_CATEGORY",
    "min_cell_size_applies": false
  },
  "fixtures": [
    {
      "name": "compare years chain snatching",
      "params": {
        "crime_subhead_id": 12
      },
      "scope_values": [
        4430006
      ],
      "expect": {
        "min_rows": 1,
        "max_rows": 10,
        "must_not_error": true
      }
    },
    {
      "name": "multi unit",
      "params": {
        "crime_subhead_id": 78
      },
      "scope_values": [
        4430006,
        4430007
      ],
      "expect": {
        "min_rows": 1,
        "max_rows": 10,
        "must_not_error": true
      }
    },
    {
      "name": "empty",
      "params": {
        "crime_subhead_id": 999
      },
      "scope_values": [
        4430006
      ],
      "expect": {
        "min_rows": 0,
        "max_rows": 0,
        "must_not_error": true
      }
    }
  ],
  "limitations": [
    "Year-over-year on registered counts. A partial current year reads as a fall; note it."
  ]
}