{
  "id": "TPL_CHARGESHEET_RATE",
  "version": "1.0.0",
  "intent": "CHARGESHEET_RATE",
  "tier": "A",
  "deprecated": false,
  "author": "P2",
  "reviewer": "P1",
  "reviewed": "2026-07-25",
  "purpose": "Chargesheet rate (share of cases chargesheeted) for one crime sub-head in one year, by unit, within jurisdiction. Uses AVG on a boolean, avoiding CASE WHEN which ZCQL lacks.",
  "tables_declared": [
    "si_case_fact"
  ],
  "params": {
    "crime_subhead_id": {
      "type": "int",
      "required": true,
      "min": 1,
      "max": 9999,
      "description": "The specific offence."
    },
    "year_num": {
      "type": "year",
      "required": true,
      "min": 2019,
      "max": 2026,
      "description": "Single year."
    }
  },
  "scope": {
    "column": "unit_id",
    "conditions_consumed": 1,
    "exempt": false
  },
  "where_budget": {
    "template_conditions": 2,
    "ceiling": 5
  },
  "body": "SELECT unit_id, AVG(is_chargesheeted) FROM si_case_fact WHERE crime_subhead_id = {{crime_subhead_id}} AND year_num = {{year_num}} AND {{SCOPE_PREDICATE}} GROUP BY unit_id ORDER BY AVG(is_chargesheeted) DESC",
  "execute_on": "OLAP",
  "result": {
    "columns": [
      {
        "name": "unit_id",
        "source_key": "unit_id",
        "type": "int"
      },
      {
        "name": "rate",
        "source_key": "AVG(is_chargesheeted)",
        "type": "float"
      }
    ],
    "max_rows": 50,
    "paginate": false,
    "visual_type": "BAR_CATEGORY",
    "min_cell_size_applies": true
  },
  "fixtures": [
    {
      "name": "chargesheet rate chain snatching 2024",
      "params": {
        "crime_subhead_id": 12,
        "year_num": 2024
      },
      "scope_values": [
        4430006,
        4430007,
        4430011
      ],
      "expect": {
        "min_rows": 1,
        "max_rows": 50,
        "must_not_error": true
      }
    },
    {
      "name": "single unit",
      "params": {
        "crime_subhead_id": 45,
        "year_num": 2024
      },
      "scope_values": [
        4430006
      ],
      "expect": {
        "min_rows": 1,
        "max_rows": 50,
        "must_not_error": true
      }
    },
    {
      "name": "edge \u2014 empty",
      "params": {
        "crime_subhead_id": 12,
        "year_num": 2019
      },
      "scope_values": [
        4430006
      ],
      "expect": {
        "min_rows": 0,
        "max_rows": 0,
        "must_not_error": true
      }
    }
  ],
  "limitations": [
    "Chargesheet status source must be confirmed with P1 (ChargesheetDetails.cstype vs CaseStatusMaster). The evidence panel names which was used.",
    "A low rate can mean active investigation, not failure \u2014 recent cases may simply be open."
  ]
}