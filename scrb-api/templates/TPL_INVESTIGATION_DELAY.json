{
  "id": "TPL_INVESTIGATION_DELAY",
  "version": "1.0.0",
  "intent": "INVESTIGATION_DELAY",
  "tier": "B",
  "deprecated": false,
  "author": "P2",
  "reviewer": "P1",
  "reviewed": "2026-07-25",
  "purpose": "Average investigation duration (days to chargesheet) by unit for a sub-head in a year.",
  "tables_declared": [
    "si_case_fact"
  ],
  "params": {
    "crime_subhead_id": {
      "type": "int",
      "required": true,
      "min": 1,
      "max": 9999,
      "description": "Specific offence sub-head."
    },
    "year_num": {
      "type": "year",
      "required": true,
      "min": 2019,
      "max": 2026,
      "description": "Single year, from IncidentFromDate."
    }
  },
  "scope": {
    "column": "unit_id",
    "conditions_consumed": 1,
    "exempt": false
  },
  "where_budget": {
    "template_conditions": 2,
    "ceiling": 5
  },
  "body": "SELECT unit_id, AVG(investigation_days) FROM si_case_fact WHERE crime_subhead_id = {{crime_subhead_id}} AND year_num = {{year_num}} AND {{SCOPE_PREDICATE}} GROUP BY unit_id ORDER BY AVG(investigation_days) DESC",
  "execute_on": "OLAP",
  "result": {
    "columns": [
      {
        "name": "unit_id",
        "source_key": "unit_id",
        "type": "int"
      },
      {
        "name": "avg_days",
        "source_key": "AVG(investigation_days)",
        "type": "float"
      }
    ],
    "max_rows": 50,
    "paginate": false,
    "visual_type": "BAR_CATEGORY",
    "min_cell_size_applies": true
  },
  "fixtures": [
    {
      "name": "delay chain snatching",
      "params": {
        "crime_subhead_id": 12,
        "year_num": 2024
      },
      "scope_values": [
        4430006,
        4430007,
        4430011
      ],
      "expect": {
        "min_rows": 1,
        "max_rows": 50,
        "must_not_error": true
      }
    },
    {
      "name": "single",
      "params": {
        "crime_subhead_id": 78,
        "year_num": 2024
      },
      "scope_values": [
        4430006
      ],
      "expect": {
        "min_rows": 1,
        "max_rows": 50,
        "must_not_error": true
      }
    },
    {
      "name": "empty",
      "params": {
        "crime_subhead_id": 12,
        "year_num": 2019
      },
      "scope_values": [
        4430006
      ],
      "expect": {
        "min_rows": 0,
        "max_rows": 0,
        "must_not_error": true
      }
    }
  ],
  "limitations": [
    "Open cases have no chargesheet date and are excluded; a unit with many open cases can look artificially fast."
  ]
}