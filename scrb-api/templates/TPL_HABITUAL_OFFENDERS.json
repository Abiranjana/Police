{
  "id": "TPL_HABITUAL_OFFENDERS",
  "version": "1.0.0",
  "intent": "HABITUAL_OFFENDERS",
  "tier": "A",
  "deprecated": false,
  "author": "P2",
  "reviewer": "P1",
  "reviewed": "2026-07-25",
  "purpose": "Accused persons with repeat involvement (>=2 cases) for a sub-head in a year within jurisdiction. HAVING filter.",
  "tables_declared": [
    "si_case_fact"
  ],
  "params": {
    "crime_subhead_id": {
      "type": "int",
      "required": true,
      "min": 1,
      "max": 9999,
      "description": "Specific offence sub-head."
    },
    "year_num": {
      "type": "year",
      "required": true,
      "min": 2019,
      "max": 2026,
      "description": "Single year, from IncidentFromDate."
    }
  },
  "scope": {
    "column": "unit_id",
    "conditions_consumed": 1,
    "exempt": false
  },
  "where_budget": {
    "template_conditions": 2,
    "ceiling": 5
  },
  "body": "SELECT accused_person_id, COUNT(case_id) FROM si_case_fact WHERE crime_subhead_id = {{crime_subhead_id}} AND year_num = {{year_num}} AND {{SCOPE_PREDICATE}} GROUP BY accused_person_id HAVING COUNT(case_id) >= 2 ORDER BY COUNT(case_id) DESC",
  "execute_on": "OLAP",
  "result": {
    "columns": [
      {
        "name": "accused_person_id",
        "source_key": "accused_person_id",
        "type": "string"
      },
      {
        "name": "count",
        "source_key": "COUNT(case_id)",
        "type": "int"
      }
    ],
    "max_rows": 50,
    "paginate": false,
    "visual_type": "BAR_CATEGORY",
    "min_cell_size_applies": true
  },
  "fixtures": [
    {
      "name": "habitual chain snatching",
      "params": {
        "crime_subhead_id": 12,
        "year_num": 2024
      },
      "scope_values": [
        4430006,
        4430007,
        4430011
      ],
      "expect": {
        "min_rows": 0,
        "max_rows": 50,
        "must_not_error": true
      }
    },
    {
      "name": "single unit",
      "params": {
        "crime_subhead_id": 12,
        "year_num": 2024
      },
      "scope_values": [
        4430006
      ],
      "expect": {
        "min_rows": 0,
        "max_rows": 50,
        "must_not_error": true
      }
    },
    {
      "name": "empty",
      "params": {
        "crime_subhead_id": 12,
        "year_num": 2019
      },
      "scope_values": [
        4430006
      ],
      "expect": {
        "min_rows": 0,
        "max_rows": 0,
        "must_not_error": true
      }
    }
  ],
  "limitations": [
    "Habitual = threshold rule on registered accusations, per the design doc's >=N-in-M rule. Not a conviction record and not a watchlist.",
    "Uses ZCQL HAVING with an aggregate \u2014 a construct the probe kit must confirm live before this template is trusted in production."
  ]
}