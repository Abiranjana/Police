{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "scrb-insight/contract-3-answer/v1.0.0",
  "title": "Contract 3 — ANSWER (P2 to P5)",
  "description": "The response body of GET /turns/{turn_id}. Frozen. P5 builds the entire frontend against this shape and never waits for a backend. Changes require a version bump and a note to P5; fields are added, never renamed or removed.",
  "type": "object",
  "required": ["turn_id", "conversation_id", "outcome", "audit_id"],
  "additionalProperties": false,
  "properties": {
    "turn_id": { "type": "string" },
    "conversation_id": { "type": "string" },
    "outcome": {
      "type": "string",
      "enum": ["ANSWERED", "ANSWERED_WITH_WARNINGS", "REFUSED", "CLARIFICATION_NEEDED", "UNSUPPORTED", "ERROR"],
      "description": "REFUSED means the permission engine denied it and error.rule_code is populated. UNSUPPORTED means no template exists and error.nearest_supported is populated."
    },
    "answer": {
      "type": ["object", "null"],
      "description": "Null on any non-answering outcome.",
      "required": ["summary"],
      "additionalProperties": false,
      "properties": {
        "summary": { "type": "string", "description": "Two sentences maximum. Generated from projected aggregates only, never from identities." },
        "reasoning": { "type": ["string", "null"], "description": "Constrained reasoning text. Must state what the number does and does not establish." },
        "visual": {
          "type": ["object", "null"],
          "required": ["type", "spec"],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["HEATMAP_DAY_HOUR", "LINE_TIME", "BAR_CATEGORY", "STACKED_BAR", "MAP_CHOROPLETH", "MAP_POINTS", "NETWORK_GRAPH", "SCATTER", "TABLE_ONLY", "NONE"]
            },
            "spec": { "type": "object", "description": "Chart-type-specific payload. P5 owns rendering; P2 owns the contract for each type." }
          }
        },
        "table": {
          "type": ["object", "null"],
          "required": ["columns", "rows"],
          "properties": {
            "columns": { "type": "array", "items": { "type": "string" } },
            "rows": { "type": "array", "items": { "type": "array" } },
            "truncated": { "type": "boolean", "description": "True when the result exceeded the ZCQL 300-row page and only the first page is shown." },
            "total_rows": { "type": ["integer", "null"] }
          }
        }
      }
    },
    "evidence": {
      "type": ["object", "null"],
      "description": "The fourteen fields. Every one is rendered in the evidence panel; none is optional once outcome is ANSWERED.",
      "required": ["question", "intent", "entities", "permission", "template", "zcql", "tables_used", "source", "rows_returned", "rows_suppressed", "execution_ms", "confidence", "data_as_of", "warnings"],
      "additionalProperties": false,
      "properties": {
        "question": {
          "type": "object",
          "properties": {
            "raw": { "type": "string" },
            "language": { "type": "string", "enum": ["en", "kn"] },
            "via": { "type": "string", "enum": ["TEXT", "VOICE"] }
          }
        },
        "intent": {
          "type": "object",
          "properties": {
            "value": { "type": "string" },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "entities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["slot", "value", "source"],
            "properties": {
              "slot": { "type": "string" },
              "value": {},
              "label": { "type": ["string", "null"] },
              "source": { "type": "string", "enum": ["STATED", "INHERITED_FROM_SESSION", "INHERITED_FROM_TURN", "DERIVED", "DEFAULTED"] }
            }
          }
        },
        "permission": {
          "type": "object",
          "properties": {
            "role": { "type": "string", "enum": ["SI", "SP", "ANALYST", "POLICY", "ADMIN"] },
            "scope_rule": { "type": "string" },
            "field_policy": { "type": "string", "enum": ["FULL", "INITIALS", "DEIDENTIFIED", "AGGREGATE_ONLY"] },
            "min_cell_size": { "type": "integer" },
            "narrowed": { "type": "boolean", "description": "True when the request was silently reduced to the user's jurisdiction rather than refused." },
            "rule_id": { "type": ["integer", "null"] }
          }
        },
        "template": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "version": { "type": "string" },
            "author": { "type": "string" },
            "reviewer": { "type": ["string", "null"] },
            "reviewed": { "type": ["string", "null"], "format": "date" }
          }
        },
        "zcql": {
          "type": "string",
          "description": "The exact statement executed, scope predicate included, after substitution. This is what a court would be shown. It must be the executed string, not a reconstruction."
        },
        "tables_used": { "type": "array", "items": { "type": "string" } },
        "source": { "type": "string", "enum": ["OLAP", "PRIMARY", "CACHE", "PRECOMPUTED"] },
        "rows_returned": { "type": "integer" },
        "rows_suppressed": { "type": "integer", "description": "Cells dropped for falling below min_cell_size." },
        "pages_fetched": { "type": "integer", "description": "ZCQL caps a result at 300 rows. More than one means the builder paginated." },
        "execution_ms": {
          "type": "object",
          "properties": {
            "route": { "type": "number" },
            "permission": { "type": "number" },
            "query": { "type": "number" },
            "analytics": { "type": "number" },
            "summarise": { "type": "number" },
            "total": { "type": "number" }
          }
        },
        "confidence": {
          "type": "object",
          "properties": {
            "intent": { "type": "number" },
            "analytical": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] }
          }
        },
        "data_as_of": { "type": "string", "format": "date-time" },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string", "description": "User-facing, non-technical." }
            }
          }
        }
      }
    },
    "error": {
      "type": ["object", "null"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "detail": { "type": ["string", "null"] },
        "rule_code": { "type": ["string", "null"] },
        "clarifying_question": { "type": ["string", "null"] },
        "options": { "type": ["array", "null"], "items": { "type": "object" } },
        "nearest_supported": { "type": ["array", "null"], "items": { "type": "string" } }
      }
    },
    "audit_id": { "type": "string" }
  }
}
